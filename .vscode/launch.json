{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/server", // 确保这是正确的可执行文件路径
            "args": ["-i", "./test.conf"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/bin/", // 设置为 bin 目录
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",

            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            // "preLaunchTask": "build", // 如果不需要预启动任务，可以注释或删除这行
            // "miDebuggerPath": "/path/to/gdb" // 如果使用系统默认 GDB，可以注释或删除这行
        }
    ]
}
